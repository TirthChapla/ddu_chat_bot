# LLM Provider Options: "gemini", "ollama", "huggingface", "mock"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Ollama Settings (If using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# HuggingFace Settings
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=BAAI/bge-small-en-v1.5

# Embeddings Model: "local" (BAAI/bge-small-en-v1.5 or all-MiniLM-L6-v2) or "gemini"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB Settings
CHROMA_PERSIST_DIR=./vectordb
COLLECTION_NAME=ddu_knowledge_base

# Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Server Settings
HOST=127.0.0.1
PORT=8000
